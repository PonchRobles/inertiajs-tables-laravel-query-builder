{
    "name": "@ponchrobles/inertia-table",
    "version": "5.0.0",
    "description": "Full-featured DataTable component for Inertia.js + Vue 3 with Spatie Laravel Query Builder integration",
    "private": false,
    "author": "Alfonso Rodriguez (PonchRobles) <ponchrobles@gmail.com>",
    "license": "MIT",
    "type": "module",
    "main": "./dist/inertia-table.umd.js",
    "module": "./dist/inertia-table.es.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "js"
    ],
    "exports": {
        ".": {
            "import": "./dist/inertia-table.es.js",
            "require": "./dist/inertia-table.umd.js"
        }
    },
    "scripts": {
        "dev": "vite build --watch",
        "build": "vite build && cp js/index.d.ts dist/index.d.ts",
        "lint": "eslint js/ --fix"
    },
    "peerDependencies": {
        "@inertiajs/vue3": "^1.0.16 || ^2.0.0",
        "tailwind-merge": "^2.2.0 || ^3.0.0",
        "vue": "^3.4.0"
    },
    "dependencies": {
        "@floating-ui/dom": "^1.8.0",
        "qs": "^6.13.0"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^6.0.8",
        "eslint": "^10.8.0",
        "eslint-plugin-vue": "^10.10.0",
        "vite": "^8.2.0",
        "vue": "^3.5.40"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/PonchRobles/inertia-table.git"
    },
    "keywords": [
        "inertia",
        "inertiajs",
        "vue3",
        "laravel",
        "datatable",
        "table",
        "query-builder",
        "spatie",
        "tailwindcss"
    ],
    "bugs": {
        "url": "https://github.com/PonchRobles/inertia-table/issues"
    },
    "homepage": "https://github.com/PonchRobles/inertia-table#readme"
}
