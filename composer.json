{
    "name": "ponchrobles/inertia-table",
    "description": "Full-featured DataTable component for Inertia.js + Vue 3 with Spatie Laravel Query Builder integration",
    "homepage": "https://github.com/ponchrobles/inertia-table",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alfonso Rodriguez (PonchRobles)",
            "email": "ponchrobles@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.8",
        "inertiajs/inertia-laravel": "^1.0|^2.0",
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0",
        "spatie/laravel-query-builder": "^6.0"
    },
    "suggest": {
        "spatie/laravel-query-builder": "Required for server-side filtering, sorting and searching (^6.0)"
    },
    "autoload": {
        "psr-4": {
            "PonchRobles\\InertiaTable\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PonchRobles\\InertiaTable\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "php-cs-fixer": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php --verbose"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "PonchRobles\\InertiaTable\\InertiaTableServiceProvider"
            ]
        }
    }
}
