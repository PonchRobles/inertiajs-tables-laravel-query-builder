{
    "name": "@ponchrobles_/inertiajs-tables-laravel-query-builder",
    "version": "5.0.0",
    "description": "Full-featured DataTable component for Inertia.js + Vue 3 with Spatie Laravel Query Builder integration",
    "private": false,
    "author": "Alfonso Rodriguez (PonchRobles) <ponchrobles@gmail.com>",
    "license": "MIT",
    "type": "module",
    "main": "./dist/inertia-table.umd.js",
    "module": "./dist/inertia-table.es.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "js"
    ],
    "exports": {
        ".": {
            "import": "./dist/inertia-table.es.js",
            "require": "./dist/inertia-table.umd.js"
        }
    },
    "scripts": {
        "dev": "vite build --watch",
        "build": "vite build && cp js/index.d.ts dist/index.d.ts",
        "lint": "eslint js/ tests/js/ workbench/resources/js/ --fix",
        "typecheck": "tsc -p tsconfig.typecheck.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "demo:dev": "vite --config vite.workbench.config.js",
        "demo:build": "vite build --config vite.workbench.config.js"
    },
    "peerDependencies": {
        "@inertiajs/vue3": "^1.0.16 || ^2.0.0 || ^3.0.0",
        "tailwind-merge": "^2.2.0 || ^3.0.0",
        "vue": "^3.4.0"
    },
    "dependencies": {
        "@floating-ui/dom": "^1.8.0",
        "qs": "^6.16.0"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.11",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vue/test-utils": "^2.5.1",
        "autoprefixer": "^10.6.1",
        "eslint": "^10.11.0",
        "eslint-plugin-vue": "^10.11.1",
        "jsdom": "^30.1.1",
        "laravel-vite-plugin": "^3.2.0",
        "tailwindcss": "^3.4.19",
        "typescript": "^7.0.2",
        "vite": "^8.3.1",
        "vitest": "^5.0.2",
        "vue": "^3.5.43"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/PonchRobles/inertiajs-tables-laravel-query-builder.git"
    },
    "keywords": [
        "inertia",
        "inertiajs",
        "vue3",
        "laravel",
        "datatable",
        "table",
        "query-builder",
        "spatie",
        "tailwindcss"
    ],
    "bugs": {
        "url": "https://github.com/PonchRobles/inertiajs-tables-laravel-query-builder/issues"
    },
    "homepage": "https://github.com/PonchRobles/inertiajs-tables-laravel-query-builder#readme"
}
